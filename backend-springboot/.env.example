# ==========================================
# Solapur Turf Booking Backend Configuration
# ==========================================
# SECURITY WARNING: Never commit the actual .env file to version control!
# This is a template file. Copy it to .env and fill in your actual values.
# ==========================================

# ── Application Configuration ──────────────────────────────────────────
SERVER_PORT=8080
LOG_LEVEL_APP=INFO
LOG_LEVEL_SPRING=WARN

# ── Database Configuration ─────────────────────────────────────────────
# REQUIRED: PostgreSQL database connection details
DB_URL=jdbc:postgresql://localhost:5432/turf_booking_db
DB_USERNAME=your_database_username
DB_PASSWORD=your_secure_database_password
DB_POOL_MAX=20
DDL_AUTO=update

# ── JWT Security Configuration ─────────────────────────────────────────
# CRITICAL: Generate a cryptographically secure random secret
# Use: openssl rand -base64 64
# Minimum 512 bits (64 bytes) recommended
JWT_SECRET=your-512-bit-cryptographically-secure-jwt-secret-key-here-use-openssl-rand-base64-64
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ── Razorpay Payment Gateway ───────────────────────────────────────────
# CRITICAL: Get your production keys from https://dashboard.razorpay.com/
# NEVER use test keys in production!
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET_HERE

# ── Email Configuration (Gmail SMTP) ───────────────────────────────────
# Use Gmail App Password (not your actual Gmail password)
# Generate at: https://myaccount.google.com/apppasswords
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-16-character-app-password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# ── CORS Security ──────────────────────────────────────────────────────
# CRITICAL: Set to your actual frontend URL(s), comma-separated
# Examples:
#   Development: http://localhost:3000
#   Production: https://yourdomain.com,https://www.yourdomain.com
# NEVER use "*" in production!
ALLOWED_ORIGINS=http://localhost:3000

# ── Firebase Configuration ─────────────────────────────────────────────
# Path to Firebase service account JSON file
FIREBASE_CONFIG_PATH=firebase-service-account.json
# Or provide JSON content directly (for cloud deployments)
FIREBASE_CONFIG_JSON=

# ── Google Drive Backup Configuration ──────────────────────────────────
# For automated database backups to Google Drive
GOOGLE_DRIVE_CONFIG_PATH=google-drive-service-account.json
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id

# ==========================================
# SECURITY CHECKLIST BEFORE DEPLOYMENT:
# ==========================================
# [ ] All secrets above are filled with PRODUCTION values
# [ ] JWT_SECRET is at least 64 characters (512 bits)
# [ ] Using Razorpay LIVE keys (rzp_live_xxx), not test keys
# [ ] Gmail App Password generated (not regular password)
# [ ] ALLOWED_ORIGINS set to your actual domain (not *)
# [ ] Database credentials are strong and unique
# [ ] .env file is added to .gitignore
# [ ] All team members have secure access to secrets
# [ ] Secrets are rotated regularly (every 90 days)
# ==========================================
